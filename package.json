{
  "name": "luma-english-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node src/backend/server.js",
    "server:dev": "node --watch src/backend/server.js",
    "prisma:generate": "prisma generate --schema=src/backend/prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema=src/backend/prisma/schema.prisma",
    "prisma:seed": "node src/backend/seed.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/domain.test.js",
    "test:users": "node --test tests/users.test.js",
    "test:courses": "node --test tests/courses.test.js",
    "test:enrollment": "node --test tests/enrollment.test.js",
    "test:assessments": "node --test tests/assessments.test.js",
    "test:admin": "node --test tests/admin.test.js",
    "test:path": "node --test tests/path.test.js",
    "test:all": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.js *.json index.html"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "motion": "^13.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "prisma": "^5.22.0",
    "vite": "^8.3.1"
  }
}
